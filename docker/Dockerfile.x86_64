# rf-detr-cpp — x86_64 build image
#
# Base: NVIDIA TensorRT 10 on Ubuntu 22.04 (CUDA 12.x included).
# Two stages:
#   dev  — full build toolchain + Python export scripts
#   prod — only the compiled binaries and shared libraries
#
# Build (dev):
#   docker build -f docker/Dockerfile.x86_64 --target dev -t rfdetr-cpp:dev .
#
# Build (prod, minimal):
#   docker build -f docker/Dockerfile.x86_64 --target prod -t rfdetr-cpp:prod .
#
# Run (GPU required):
#   docker run --gpus all --rm -it \
#       -v $(pwd)/trt-files:/workspace/trt-files \
#       -v $(pwd)/out:/workspace/out \
#       rfdetr-cpp:dev bash
#
# Inside the container:
#   # Export ONNX (one-time — weights download to ~/.roboflow/models/ inside the container)
#   python trt-files/scripts/export_onnx.py --variant nano --out-dir trt-files/onnx
#
#   # Build engine
#   ./build/rfdetr_build --onnx trt-files/onnx/rf-detr-nano.onnx
#
#   # Run detection
#   ./build/rfdetr_detect --engine trt-files/onnx/rf-detr-nano-fp32.engine \
#                         --image  test_img.jpg --out out/result.jpg

# ── Base: TRT 10 Ubuntu 22.04 ────────────────────────────────────────────────
ARG TRT_VERSION=10.9.0.34
ARG CUDA_VERSION=12.8.1
ARG UBUNTU_VERSION=22.04

FROM nvcr.io/nvidia/tensorrt:${TRT_VERSION}-cuda${CUDA_VERSION}-ubuntu${UBUNTU_VERSION} AS base

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        ninja-build \
        git \
        wget \
        ca-certificates \
        libopencv-dev \
        libopencv-contrib-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

# ── Dev stage: adds Python + uv for ONNX export ──────────────────────────────
FROM base AS dev

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3.10 \
        python3-pip \
        python3-dev \
    && rm -rf /var/lib/apt/lists/* \
    && pip3 install --no-cache-dir uv

# Copy source.
COPY . /workspace/

# Install Python deps (ONNX export only; C++ runtime needs none).
RUN uv venv --python python3.10 .venv \
    && .venv/bin/pip install --no-cache-dir -r requirements.txt

# Build C++ library + all apps.
RUN cmake -B build -S . \
        -DCMAKE_BUILD_TYPE=Release \
        -DRFDETR_BUILD_APPS=ON \
        -DRFDETR_BUILD_C_API=ON \
        -DCMAKE_CUDA_ARCHITECTURES=120 \
    && cmake --build build -j$(nproc)

# ── Prod stage: only binaries + shared libs ───────────────────────────────────
FROM base AS prod

COPY --from=dev /workspace/build/rfdetr_detect   /usr/local/bin/
COPY --from=dev /workspace/build/rfdetr_seg      /usr/local/bin/
COPY --from=dev /workspace/build/rfdetr_video    /usr/local/bin/
COPY --from=dev /workspace/build/rfdetr_batch    /usr/local/bin/
COPY --from=dev /workspace/build/rfdetr_build    /usr/local/bin/
COPY --from=dev /workspace/build/rfdetr_inspect  /usr/local/bin/
COPY --from=dev /workspace/build/librfdetr.so*   /usr/local/lib/
COPY --from=dev /workspace/build/librfdetr_c.so* /usr/local/lib/
RUN ldconfig

CMD ["/bin/bash"]
